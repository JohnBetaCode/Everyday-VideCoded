# Copy this file to configs/.env and fill in your local values.
# configs/.env is gitignored — never commit real paths or secrets.

# Default folder(s) pre-filled in the path input when the app starts.
# Separate multiple paths with a newline (\n) using a quoted string, or
# just set one path for the common case.
DEFAULT_PHOTOS_PATH=

# Gaussian blur radius applied to the background (pixels). Higher = stronger blur.
BLUR_RADIUS=30

# Target inter-ocular distance as a fraction of image width for the "Zoom face" op.
# 0.25 = eyes span 25% of frame width. Increase to zoom in, decrease to zoom out.
FACE_ZOOM_RATIO=0.16

# Target face position in the frame as fractions of width/height (0.0–1.0).
# FACE_ALIGN_X=0.5 centres horizontally; FACE_ALIGN_Y=0.4 places eyes slightly above centre.
FACE_ALIGN_X=0.5
FACE_ALIGN_Y=0.5

# Folder where exported images are saved. Defaults to tmp/ in the project root.
# Processed images are written to EXPORT_PATH/images/.
EXPORT_PATH=

# Date stamp overlaid on each exported frame.
DATE_FORMAT=%Y-%m-%d
DATE_FONT_SIZE=           # leave empty to auto-scale with image height
DATE_TEXT_COLOR=#FFFFFF
DATE_STROKE_COLOR=#000000
DATE_STROKE_WIDTH=2

# Video output settings for "Create video".
VIDEO_NAME=timelapse
VIDEO_EXTENSION=mp4
VIDEO_FPS=24
VIDEO_CODEC=libx264
