# Copy this file to configs/.env and fill in your local values.
# configs/.env is gitignored — never commit real paths or secrets.

# Default folder(s) pre-filled in the path input when the app starts.
# Separate multiple paths with a newline (\n) using a quoted string, or
# just set one path for the common case.
DEFAULT_PHOTOS_PATH=

# Gaussian blur radius applied to the background (pixels). Higher = stronger blur.
BLUR_RADIUS=30

# Target inter-ocular distance as a fraction of image width for the "Zoom face" op.
# 0.25 = eyes span 25% of frame width. Increase to zoom in, decrease to zoom out.
FACE_ZOOM_RATIO=0.16

# Target face position in the frame as fractions of width/height (0.0–1.0).
# FACE_ALIGN_X=0.5 centres horizontally; FACE_ALIGN_Y=0.4 places eyes slightly above centre.
FACE_ALIGN_X=0.5
FACE_ALIGN_Y=0.5

# Folder where exported images are saved. Defaults to tmp/ in the project root.
# Processed images are written to EXPORT_PATH/images/.
EXPORT_PATH=

# Number of parallel worker threads for export (default: 4).
EXPORT_WORKERS=10

# Sort order used to number exported frames within each folder.
# Options: name (A→Z by filename) | date_created (EXIF date) | date_modified (file mtime)
EXPORT_SORT=name

# Output frame size for export. When both are set, every exported frame is scaled to cover
# this exact resolution (aspect-ratio preserved) and center-cropped to fit.
# Leave empty to keep each image at its original processed size.
EXPORT_WIDTH=
EXPORT_HEIGHT=


# Debug export mode — overlays all date metadata in green (top-left) instead of the normal date stamp.
# Shows: EXIF DateTime / DateTimeOriginal / DateTimeDigitized, file mtime, file ctime, and export sort mode.
# Set to 1 to enable, leave empty or unset to disable.
EXPORT_DEBUG=1

# Date stamp overlaid on each exported frame.
DATE_FORMAT=%Y-%m-%d
# Leave DATE_FONT_SIZE empty to auto-scale with image height.
DATE_FONT_SIZE=
DATE_TEXT_COLOR=#FFFFFF
DATE_STROKE_COLOR=#000000
DATE_STROKE_WIDTH=2

# Video output settings for "Create video".
VIDEO_NAME=timelapse
VIDEO_EXTENSION=mp4
VIDEO_FPS=24
VIDEO_CODEC=libx264
# Output resolution for the video (default 1920×1080). Frames are scaled to fit within
# this canvas while preserving aspect ratio; letterbox/pillarbox bars fill any gap.
# h264 requires even dimensions and a maximum of 8192px per side.
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
